# Server
PORT=8080

# Postmark — all three required; the server will not start without them.
# For local dev without email, set EMAIL_DISABLED=1 instead.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM=noreply@ateamgutter.com
POSTMARK_TO=info@ateamgutter.com

# Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
