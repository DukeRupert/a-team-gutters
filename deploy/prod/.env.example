# Production .env for /opt/a-team-gutters on firefly-sites.
# docker-compose.yml in this folder is NOT shipped by the deploy workflow;
# keep it in sync with the server copy by hand.

# Written by the deploy workflow on every deploy.
DOCKER_IMAGE=dukerupert/a-team-gutters:build-<sha>

# Host side of the port mapping. Includes the loopback address on purpose:
# Docker bypasses ufw, and Caddy on the host proxies to localhost:3010.
LISTEN_PORT=127.0.0.1:3010

# Postmark — all three required; the app refuses to start without them.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM=noreply@fireflysoftware.dev
POSTMARK_TO=jessie@ateamgutter.com

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
